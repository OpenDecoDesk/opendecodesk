{
  "name": "opendecodesk",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "test": "bash run-tests.sh",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate": "npx wrangler d1 migrations apply DB --remote",
    "db:pending": "npx wrangler d1 migrations list DB --remote",
    "db:backup:now": "bash scripts/d1-backup.sh",
    "scan": "bash scripts/scan-private.sh",
    "perf": "node --disable-warning=ExperimentalWarning perf/scale.js",
    "perf:profile": "node --disable-warning=ExperimentalWarning perf/profile.js",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "e2e:headed": "playwright test -c e2e/playwright.config.mjs --headed",
    "e2e:spec": "playwright test -c e2e/playwright.config.mjs --project=chromium",
    "e2e:report": "playwright show-report e2e/.report"
  },
  "cloudflare": {
    "label": "OpenDecoDesk",
    "products": [
      "Workers",
      "D1",
      "R2",
      "Durable Objects"
    ],
    "categories": [
      "storage"
    ],
    "bindings": {
      "PROXY_ADMIN_PASSPHRASE": {
        "description": "A **setup password you choose**, 12 characters or more. After deploying, open the address Cloudflare shows (it ends in `workers.dev`), leave the email empty and sign in with this. You then set your own email and password, and this stops opening anything. Not your Cloudflare password."
      }
    }
  },
  "dependencies": {
    "jsdom": "^24.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pdfjs-dist": "^5.6.205",
    "sql.js": "^1.14.2",
    "wrangler": "4.110.0"
  },
  "license": "AGPL-3.0-only"
}
